PORT=8081

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL Database (Supabase IPv4 Pooler)
PGHOST=aws-1-ap-southeast-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.your-project-ref
PGPASSWORD=your-database-password
PGDATABASE=postgres
PGSSL=true

# Database URL
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
